@page
@model LoginModel

@{
    ViewData["Title"] = "Log in";
}

<div class="row justify-content-left">
    <div class="col-12 col-lg-10">

        <!-- Page introduction -->
        <div class="mb-4">
            <h1 class="mb-2">Welcome back</h1>
            <p class="text-muted mb-0">
                Log in to your account to continue participating
                in the community.
            </p>
        </div>

        <!-- Main content -->
        <div class="row g-4 align-items-start">

            <!-- Login form - left column -->
            <div class="col-12 col-lg-6">

                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-body-tertiary">
                        <h2 class="h5 mb-0">Log in to your account</h2>
                    </div>

                    <div class="card-body p-4">
                        <form id="account" method="post">

                            <div asp-validation-summary="ModelOnly"
                                 class="text-danger mb-3"
                                 role="alert">
                            </div>

                            <div class="mb-3">
                                <label asp-for="Input.Email" class="form-label">
                                    Email address
                                </label>

                                <input asp-for="Input.Email"
                                       class="form-control"
                                       autocomplete="username"
                                       aria-required="true"
                                       placeholder="name@example.com" />

                                <span asp-validation-for="Input.Email"
                                      class="text-danger small">
                                </span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="Input.Password" class="form-label">
                                    Password
                                </label>

                                <input asp-for="Input.Password"
                                       class="form-control"
                                       autocomplete="current-password"
                                       aria-required="true"
                                       placeholder="Enter your password" />

                                <span asp-validation-for="Input.Password"
                                      class="text-danger small">
                                </span>
                            </div>

                            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2 mb-4">
                                <div class="form-check">
                                    <input asp-for="Input.RememberMe"
                                           class="form-check-input" />

                                    <label asp-for="Input.RememberMe"
                                           class="form-check-label">
                                        Remember me
                                    </label>
                                </div>

                                <a id="forgot-password"
                                   asp-page="./ForgotPassword"
                                   class="small text-decoration-none">
                                    Forgot password?
                                </a>
                            </div>

                            <button id="login-submit"
                                    type="submit"
                                    class="btn btn-primary w-100">
                                Log in
                            </button>

                        </form>

                        <hr class="my-4" />

                        <div>
                            <p class="text-muted mb-1">
                                Don't have an account yet?
                            </p>

                            <a asp-page="./Register"
                               asp-route-returnUrl="@Model.ReturnUrl"
                               class="fw-semibold text-decoration-none">
                                Create an account
                            </a>
                        </div>

                        <div class="mt-3">
                            <a id="resend-confirmation"
                               asp-page="./ResendEmailConfirmation"
                               class="small text-muted text-decoration-none">
                                Resend email confirmation
                            </a>
                        </div>
                    </div>
                </div>

                <!-- External login providers -->
                @if ((Model.ExternalLogins?.Count ?? 0) > 0)
                {
                    <div class="card shadow-sm mb-4">
                        <div class="card-header bg-body-tertiary">
                            <h2 class="h5 mb-0">Alternative login methods</h2>
                        </div>

                        <div class="card-body">
                            <p class="text-muted small mb-3">
                                You can also log in using one of the following services.
                            </p>

                            <form id="external-account"
                                  asp-page="./ExternalLogin"
                                  asp-route-returnUrl="@Model.ReturnUrl"
                                  method="post">

                                <div class="d-flex flex-wrap gap-2">
                                    @foreach (var provider in Model.ExternalLogins!)
                                    {
                                        <button type="submit"
                                                class="btn btn-outline-secondary"
                                                name="provider"
                                                value="@provider.Name"
                                                title="Log in using your @provider.DisplayName account">
                                            @provider.DisplayName
                                        </button>
                                    }
                                </div>
                            </form>
                        </div>
                    </div>
                }

            </div>

            <!-- Additional information - right column -->
            <div class="col-12 col-lg-6">

                <div class="mb-4">
                    <h2 class="h5 mb-3">Stay connected</h2>

                    <p class="text-muted">
                        Your account gives you access to everything
                        the forum has to offer.
                    </p>

                    <div class="d-flex align-items-start gap-3 mb-3">
                        <div class="text-primary pt-1">
                            <i class="bi bi-chat-square-text fs-4"></i>
                        </div>

                        <div>
                            <h3 class="h6 mb-1">Join discussions</h3>
                            <p class="text-muted small mb-0">
                                Participate in conversations and share
                                your thoughts with other members.
                            </p>
                        </div>
                    </div>

                    <div class="d-flex align-items-start gap-3 mb-3">
                        <div class="text-primary pt-1">
                            <i class="bi bi-people fs-4"></i>
                        </div>

                        <div>
                            <h3 class="h6 mb-1">Connect with members</h3>
                            <p class="text-muted small mb-0">
                                Find other members, build friendships
                                and stay connected.
                            </p>
                        </div>
                    </div>

                    <div class="d-flex align-items-start gap-3">
                        <div class="text-primary pt-1">
                            <i class="bi bi-chat-dots fs-4"></i>
                        </div>

                        <div>
                            <h3 class="h6 mb-1">Stay up to date</h3>
                            <p class="text-muted small mb-0">
                                Follow topics and keep up with the latest
                                community discussions.
                            </p>
                        </div>
                    </div>
                </div>

            </div>
        </div>

        <!-- Back to forum -->
        <div class="mt-3 mb-4">
            <a asp-controller="Topic"
               asp-action="Index"
               class="btn btn-outline-secondary">
                Back to forum
            </a>
        </div>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
