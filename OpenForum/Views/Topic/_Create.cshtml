@model ViewModels.Topic.TopicCreateView

<form asp-action="Create" method="post">
    <input type="hidden" name="page" value="@(ViewData["CurrentPage"] ?? 1)" />

    <div class="mb-3">
        <label asp-for="Title" class="form-label">Topic Title</label>
        <input asp-for="Title" class="form-control" placeholder="Enter a topic title..." />
        <span asp-validation-for="Title" class="text-danger small"></span>
    </div>

    <button type="submit" class="btn btn-success">
        Create Topic
    </button>
</form>