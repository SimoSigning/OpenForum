@model ViewModels.Topic.TopicEditView


<form asp-action="Update"
      method="post">


    <input asp-for="Id"
           type="hidden" />


    <div class="mb-3">

        <label asp-for="Title"
               class="form-label">
        </label>


        <input asp-for="Title"
               class="form-control" />


        <span asp-validation-for="Title"
              class="text-danger">
        </span>

    </div>


    <button type="submit"
            class="btn btn-primary">

        Save Changes

    </button>

</form>