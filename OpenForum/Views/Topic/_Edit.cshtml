@model ViewModels.Topic.TopicEditView

<form asp-action="Update" method="post">
    <input asp-for="Id" type="hidden" />
    <input type="hidden" name="page" value="@(ViewData["CurrentPage"] ?? 1)" />

    <div class="mb-3">
        <label asp-for="Title" class="form-label">Topic Title</label>
        <input asp-for="Title" class="form-control" placeholder="Enter a topic title..." />
        <span asp-validation-for="Title" class="text-danger small"></span>
    </div>

    <div class="d-flex flex-wrap gap-2">
        <button type="submit" class="btn btn-primary">
            Save Changes
        </button>
        <button type="button" id="cancelEditTopic" class="btn btn-outline-secondary">
            Cancel
        </button>
    </div>
</form>