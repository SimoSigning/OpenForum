@model ViewModels.Topic.TopicIndexView

@{
    ViewData["Title"] = "Topics";
}

<div class="row">

    <div class="col-lg-8">

        <h1 class="mb-4">
            Forum Topics
        </h1>

        <div class="card shadow-sm mb-4">

            <div class="card-header">
                <h2 class="h5 mb-0">
                    Create Topic
                </h2>
            </div>

            <div class="card-body">
                @await Html.PartialAsync("_Create", Model.CreateTopic)
            </div>

        </div>

        <h2 class="h4 mb-3">
            Existing Topics
        </h2>

        @if (!Model.Topics.Any())
        {
            <div class="alert alert-info">
                No topics exist yet.
            </div>
        }
        else
        {
            foreach (ViewModels.Topic.TopicListItemView topic in Model.Topics)
            {
                <div class="card shadow-sm mb-3">

                    <div class="card-body">

                        <h3 class="h5">
                            @topic.Title
                        </h3>

                        <p class="text-muted">
                            Created:
                            @topic.CreatedAt
                        </p>

                        <p class="text-muted">
                            Created by:
                            @topic.Creator
                        </p>

                        <div class="d-flex gap-2">

                            <a asp-controller="Post"
                               asp-action="Details"
                               asp-route-id="@topic.Id"
                               class="btn btn-primary btn-sm">
                                View Topic
                            </a>

                            <a asp-action="Edit"
                               asp-route-id="@topic.Id"
                               asp-route-page="@Model.CurrentPage"
                               class="btn btn-outline-secondary btn-sm">
                                Edit
                            </a>

                            <form asp-action="Delete" method="post">

                                <input type="hidden"
                                       name="id"
                                       value="@topic.Id" />

                                <input type="hidden"
                                       name="page"
                                       value="@Model.CurrentPage" />

                                <button type="submit"
                                        class="btn btn-outline-danger btn-sm">
                                    Delete
                                </button>

                            </form>

                        </div>

                    </div>

                </div>
            }
        }

        @if (Model.TotalPages > 1)
        {
            <nav aria-label="Topic pagination" class="mt-4">

                <ul class="pagination justify-content-center">

                    <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
                        @if (Model.CurrentPage > 1)
                        {
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-page="@(Model.CurrentPage - 1)">
                                Previous
                            </a>
                        }
                        else
                        {
                            <span class="page-link">Previous</span>
                        }
                    </li>

                    @for (int pageNumber = 1;
                          pageNumber <= Model.TotalPages;
                          pageNumber++)
                    {
                        <li class="page-item @(pageNumber == Model.CurrentPage ? "active" : "")">
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-page="@pageNumber"
                               aria-current="@(pageNumber == Model.CurrentPage ? "page" : null)">
                                @pageNumber
                            </a>
                        </li>
                    }

                    <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
                        @if (Model.CurrentPage < Model.TotalPages)
                        {
                            <a class="page-link"
                               asp-action="Index"
                               asp-route-page="@(Model.CurrentPage + 1)">
                                Next
                            </a>
                        }
                        else
                        {
                            <span class="page-link">Next</span>
                        }
                    </li>

                </ul>

            </nav>
        }

        @if (Model.EditTopic != null)
        {
            <div class="card shadow-sm mt-4">

                <div class="card-header">
                    <h2 class="h5 mb-0">
                        Edit Topic
                    </h2>
                </div>

                <div class="card-body">
                    @await Html.PartialAsync("_Edit", Model.EditTopic)
                </div>

            </div>
        }

    </div>

</div>
