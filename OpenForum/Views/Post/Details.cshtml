@model ViewModels.Post.PostIndexView

@{
    ViewData["Title"] = Model.TopicTitle;
}

<div class="row">
    <div class="col-12 col-lg-9 mx-auto">

    <div class="d-flex justify-content-between align-items-start gap-3 mb-4">
        <h1 class="mb-0">@Model.TopicTitle</h1>
        <div class="text-muted small text-end flex-shrink-0">
            Started by <strong class="text-body">@Model.TopicCreator</strong>
        </div>
    </div>

    @if (Model.CanCreate)
    {
        <div id="createPostCard" class="card shadow-sm mb-4 @(Model.EditPost != null ? "d-none" : "")">
            <div class="card-header">
                <h2 class="h5 mb-0">Create Post</h2>
            </div>
            <div class="card-body">
                @await Html.PartialAsync("_Create", Model.CreatePost)
            </div>
        </div>
    }

        @if (Model.EditPost != null)
        {
            <div id="editPostCard" class="card shadow-sm mb-4">
                <div class="card-header bg-body-tertiary">
                    <h2 class="h5 mb-0">Edit Post</h2>
                </div>
                <div class="card-body">
                    @await Html.PartialAsync("_Edit", Model.EditPost)
                </div>
            </div>
        }

        <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2 mb-3">
            <div>
                <h2 class="h4 mb-1">
                    Posts
                </h2>

                <p class="text-muted mb-0">
                    Read and join the discussion.
                </p>
            </div>

            <span class="badge bg-secondary rounded-pill align-self-start align-self-sm-center">
                @Model.Posts.Count() @(Model.Posts.Count() == 1 ? "post" : "posts")
            </span>
        </div>

        @if (!Model.Posts.Any())
        {
            <div class="card shadow-sm">
                <div class="card-body text-center py-5">
                    <h3 class="h5 mb-2">
                        No posts yet
                    </h3>

                    <p class="text-muted mb-0">
                        There are no posts in this topic yet.
                        @if (Model.CanCreate)
                        {
                            <span>Start the discussion by writing the first post.</span>
                        }
                    </p>
                </div>
            </div>
        }
        else
        {
            <div class="d-flex flex-column gap-3">
                @foreach (ViewModels.Post.PostListItemView post in Model.Posts)
                {
                    <div class="card shadow-sm">
                        <div class="card-body">
                            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-start gap-3">
                                <div class="flex-grow-1">
                                    <h3 class="h5 mb-2">
                                        @post.Title
                                    </h3>

                                    <p class="mb-3">
                                        @post.Content
                                    </p>

                                    <div class="d-flex flex-wrap align-items-center gap-2 text-muted small mb-3">
                                        <span>By <strong class="text-body">@post.Creator</strong></span>
                                        <span aria-hidden="true">&middot;</span>
                                        <span>@post.CreatedAt</span>
                                    </div>

                                    <div class="d-flex align-items-center gap-2">
                                        @if (post.CanLike)
                                        {
                                            <form asp-controller="Like"
                                                  asp-action="TogglePostLike"
                                                  method="post"
                                                  class="d-inline">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden" name="postId" value="@post.Id" />
                                                <input type="hidden" name="returnUrl"
                                                       value="@Url.Action("Details", "Post",
                                                           new { id = Model.TopicId, page = Model.CurrentPage })" />

                                                <button type="submit"
                                                        class="btn btn-sm @(post.IsLikedByCurrentUser ? "btn-primary" : "btn-outline-primary")"
                                                        aria-pressed="@post.IsLikedByCurrentUser">
                                                    @(post.IsLikedByCurrentUser ? "♥ Liked" : "♡ Like")
                                                    <span class="ms-1">@post.LikeCount</span>
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">
                                                ♡ @post.LikeCount @(post.LikeCount == 1 ? "like" : "likes")
                                            </span>
                                        }
                                    </div>
                                </div>

                                <div class="d-flex flex-wrap gap-2 flex-shrink-0">
                                    <a asp-controller="Comment" asp-action="Details" asp-route-id="@post.Id" class="btn btn-primary btn-sm">
                                        View Post
                                    </a>

                                    @if (post.CanManage)
                                    {
                                        <a asp-action="Edit" asp-route-id="@post.Id" asp-route-page="@Model.CurrentPage" class="btn btn-outline-secondary btn-sm">
                                            Edit
                                        </a>

                                        <form asp-action="Delete" method="post" onsubmit="return confirm('Are you sure you want to delete this post?');">
                                            <input type="hidden" name="id" value="@post.Id" />
                                            <input type="hidden" name="topicId" value="@Model.TopicId" />
                                            <input type="hidden" name="page" value="@Model.CurrentPage" />
                                            <button type="submit" class="btn btn-outline-danger btn-sm">
                                                Delete
                                            </button>
                                        </form>
                                    }
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }

        @if (Model.TotalPages > 1)
        {
            <nav aria-label="Post pagination" class="mt-4">
                <ul class="pagination flex-wrap mb-0">
                    <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
                        @if (Model.CurrentPage > 1)
                        {
                            <a class="page-link" asp-action="Details" asp-route-id="@Model.TopicId" asp-route-page="@(Model.CurrentPage - 1)">
                                Previous
                            </a>
                        }
                        else
                        {
                            <span class="page-link">Previous</span>
                        }
                    </li>

                    @for (int pageNumber = 1; pageNumber <= Model.TotalPages; pageNumber++)
                    {
                        <li class="page-item @(pageNumber == Model.CurrentPage ? "active" : "")">
                            <a class="page-link" asp-action="Details" asp-route-id="@Model.TopicId" asp-route-page="@pageNumber" aria-current="@(pageNumber == Model.CurrentPage ? "page" : null)">
                                @pageNumber
                            </a>
                        </li>
                    }

                    <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
                        @if (Model.CurrentPage < Model.TotalPages)
                        {
                            <a class="page-link" asp-action="Details" asp-route-id="@Model.TopicId" asp-route-page="@(Model.CurrentPage + 1)">
                                Next
                            </a>
                        }
                        else
                        {
                            <span class="page-link">Next</span>
                        }
                    </li>
                </ul>
            </nav>
        }
    </div>
</div>
<script>
    document.addEventListener("DOMContentLoaded", function () {
        const createPostCard = document.getElementById("createPostCard");
        const editPostCard = document.getElementById("editPostCard");
        const cancelEditPost = document.getElementById("cancelEditPost");

        if (cancelEditPost) {
            cancelEditPost.addEventListener("click", function () {
                if (editPostCard) {
                    editPostCard.classList.add("d-none");
                }

                if (createPostCard) {
                    createPostCard.classList.remove("d-none");
                }
            });
        }
    });
</script>