
@model ViewModels.Comment.CommentIndexView

@{
    ViewData["Title"] = "Post Details";
    ViewData["CurrentPage"] = Model.CurrentPage;

    int? replyParentCommentId =
        ViewData["ReplyParentCommentId"] is int parentId
            ? parentId
            : null;

    string? replyContent = ViewData["ReplyContent"] as string;
    string? replyError = ViewData["ReplyError"] as string;
}

<div class="row">
    <div class="col-12 col-lg-9 mx-auto">

        <div class="d-flex justify-content-between align-items-center gap-3 mb-4">
            <h1 class="mb-0">Post Details</h1>
            <a asp-controller="Post"
               asp-action="Details"
               asp-route-id="@Model.TopicId"
               class="btn btn-outline-secondary btn-sm flex-shrink-0">
                Back to Topic
            </a>
        </div>

        <div class="card shadow-sm mb-4">
            <div class="card-header bg-body-tertiary">
                <h2 class="h5 mb-0">Post Content</h2>
            </div>

            <div class="card-body">
                <p class="mb-3">@Model.PostContent</p>

                <div class="d-flex flex-wrap align-items-center gap-2 text-muted small">
                    <span>By <strong class="text-body">@Model.PostCreator</strong></span>
                    <span aria-hidden="true">&middot;</span>
                    <span>@Model.PostCreatedAt</span>
                </div>
            </div>
        </div>

        @if (Model.CanCreate)
        {
            <div id="createCommentCard"
                 class="card shadow-sm mb-4 @(Model.EditComment != null ? "d-none" : "")">
                <div class="card-header">
                    <h2 class="h5 mb-0">Create Comment</h2>
                </div>
                <div class="card-body">
                    @await Html.PartialAsync("_Create", Model.CreateComment)
                </div>
            </div>
        }

        @if (Model.EditComment != null)
        {
            <div id="editCommentCard" class="card shadow-sm mb-4">
                <div class="card-header bg-body-tertiary">
                    <h2 class="h5 mb-0">Edit Comment</h2>
                </div>
                <div class="card-body">
                    @await Html.PartialAsync("_Edit", Model.EditComment)
                </div>
            </div>
        }

        <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2 mb-3">
            <div>
                <h2 class="h4 mb-1">Comments</h2>
                <p class="text-muted mb-0">Share your thoughts on this post.</p>
            </div>

            <span class="badge bg-secondary rounded-pill align-self-start align-self-sm-center">
                @Model.Comments.Count()
                @(Model.Comments.Count() == 1 ? "thread" : "threads")
            </span>
        </div>

        @if (!Model.Comments.Any())
        {
            <div class="card shadow-sm">
                <div class="card-body text-center py-5">
                    <h3 class="h5 mb-2">No comments yet</h3>
                    <p class="text-muted mb-0">
                        There are no comments on this post yet.
                        @if (Model.CanCreate)
                        {
                            <span>Be the first to share your thoughts.</span>
                        }
                    </p>
                </div>
            </div>
        }
        else
        {
            <div class="d-flex flex-column gap-3">
                @foreach (ViewModels.Comment.CommentListItemView comment in Model.Comments)
                {
                    bool replyFormOpen = replyParentCommentId == comment.Id;

                    <div class="card shadow-sm" id="comment-@comment.Id">
                        <div class="card-body">

                            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-start gap-3">
                                <div class="flex-grow-1">
                                    @if (!string.IsNullOrWhiteSpace(comment.Title))
                                    {
                                        <h3 class="h5 mb-2">@comment.Title</h3>
                                    }

                                    <p class="mb-3">@comment.Content</p>

                                    <div class="d-flex flex-wrap align-items-center gap-2 text-muted small">
                                        <span>By <strong class="text-body">@comment.Creator</strong></span>
                                        <span aria-hidden="true">&middot;</span>
                                        <span>@comment.CreatedAt</span>
                                    </div>
                                </div>

                                @if (comment.CanManage)
                                {
                                    <div class="d-flex flex-wrap gap-2 flex-shrink-0">
                                        <a asp-action="Edit"
                                           asp-route-id="@comment.Id"
                                           asp-route-page="@Model.CurrentPage"
                                           class="btn btn-outline-secondary btn-sm">
                                            Edit
                                        </a>

                                        <form asp-action="Delete"
                                              method="post"
                                              onsubmit="return confirm('Are you sure you want to delete this comment?');">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@comment.Id" />
                                            <input type="hidden" name="postId" value="@Model.PostId" />
                                            <input type="hidden" name="page" value="@Model.CurrentPage" />

                                            <button type="submit" class="btn btn-outline-danger btn-sm">
                                                Delete
                                            </button>
                                        </form>
                                    </div>
                                }
                            </div>

                            @if (comment.CanReply)
                            {
                                <div class="mt-3">
                                    <button type="button"
                                            class="btn btn-outline-primary btn-sm reply-toggle"
                                            data-comment-id="@comment.Id"
                                            aria-expanded="@(replyFormOpen ? "true" : "false")"
                                            aria-controls="reply-form-@comment.Id">
                                        Reply
                                    </button>
                                </div>

                                <div id="reply-form-@comment.Id"
                                     class="reply-form mt-3 @(replyFormOpen ? "" : "d-none")">

                                    <form asp-controller="Comment"
                                          asp-action="Create"
                                          method="post">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden" name="PostId" value="@Model.PostId" />
                                        <input type="hidden" name="ParentCommentId" value="@comment.Id" />
                                        <input type="hidden" name="page" value="@Model.CurrentPage" />

                                        <div class="mb-3">
                                            <label for="reply-content-@comment.Id"
                                                   class="form-label">
                                                Your reply
                                            </label>

                                            <textarea id="reply-content-@comment.Id"
                                                      name="Content"
                                                      class="form-control"
                                                      rows="3"
                                                      maxlength="2000"
                                                      required
                                                      placeholder="Write a reply...">@(replyFormOpen ? replyContent : "")</textarea>

                                            @if (replyFormOpen && !string.IsNullOrWhiteSpace(replyError))
                                            {
                                                <div class="text-danger small mt-1">
                                                    @replyError
                                                </div>
                                            }
                                        </div>

                                        <div class="d-flex flex-wrap gap-2">
                                            <button type="submit" class="btn btn-primary btn-sm">
                                                Post Reply
                                            </button>

                                            <button type="button"
                                                    class="btn btn-outline-secondary btn-sm reply-cancel"
                                                    data-comment-id="@comment.Id">
                                                Cancel
                                            </button>
                                        </div>
                                    </form>
                                </div>
                            }

                            @if (comment.Replies.Any())
                            {
                                <div class="mt-4 ms-2 ms-md-4 ps-3 border-start">
                                    <h4 class="h6 text-muted mb-3">
                                        Replies (@comment.Replies.Count)
                                    </h4>

                                    <div class="d-flex flex-column gap-3">
                                        @foreach (ViewModels.Comment.CommentListItemView reply in comment.Replies)
                                        {
                                            <div class="card bg-body-tertiary border-0"
                                                 id="comment-@reply.Id">
                                                <div class="card-body">
                                                    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-start gap-3">
                                                        <div class="flex-grow-1">
                                                            <p class="mb-3">@reply.Content</p>

                                                            <div class="d-flex flex-wrap align-items-center gap-2 text-muted small">
                                                                <span>By <strong class="text-body">@reply.Creator</strong></span>
                                                                <span aria-hidden="true">&middot;</span>
                                                                <span>@reply.CreatedAt</span>
                                                            </div>
                                                        </div>

                                                        @if (reply.CanManage)
                                                        {
                                                            <div class="d-flex flex-wrap gap-2 flex-shrink-0">
                                                                <a asp-action="Edit"
                                                                   asp-route-id="@reply.Id"
                                                                   asp-route-page="@Model.CurrentPage"
                                                                   class="btn btn-outline-secondary btn-sm">
                                                                    Edit
                                                                </a>

                                                                <form asp-action="Delete"
                                                                      method="post"
                                                                      onsubmit="return confirm('Are you sure you want to delete this reply?');">
                                                                    @Html.AntiForgeryToken()
                                                                    <input type="hidden" name="id" value="@reply.Id" />
                                                                    <input type="hidden" name="postId" value="@Model.PostId" />
                                                                    <input type="hidden" name="page" value="@Model.CurrentPage" />

                                                                    <button type="submit" class="btn btn-outline-danger btn-sm">
                                                                        Delete
                                                                    </button>
                                                                </form>
                                                            </div>
                                                        }
                                                    </div>
                                                </div>
                                            </div>
                                        }
                                    </div>
                                </div>
                            }
                        </div>
                    </div>
                }
            </div>
        }

        @if (Model.TotalPages > 1)
        {
            <nav aria-label="Comment pagination" class="mt-4">
                <ul class="pagination flex-wrap mb-0">
                    <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
                        @if (Model.CurrentPage > 1)
                        {
                            <a class="page-link"
                               asp-action="Details"
                               asp-route-id="@Model.PostId"
                               asp-route-page="@(Model.CurrentPage - 1)">
                                Previous
                            </a>
                        }
                        else
                        {
                            <span class="page-link">Previous</span>
                        }
                    </li>

                    @for (int pageNumber = 1; pageNumber <= Model.TotalPages; pageNumber++)
                    {
                        <li class="page-item @(pageNumber == Model.CurrentPage ? "active" : "")">
                            <a class="page-link"
                               asp-action="Details"
                               asp-route-id="@Model.PostId"
                               asp-route-page="@pageNumber"
                               aria-current="@(pageNumber == Model.CurrentPage ? "page" : null)">
                                @pageNumber
                            </a>
                        </li>
                    }

                    <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
                        @if (Model.CurrentPage < Model.TotalPages)
                        {
                            <a class="page-link"
                               asp-action="Details"
                               asp-route-id="@Model.PostId"
                               asp-route-page="@(Model.CurrentPage + 1)">
                                Next
                            </a>
                        }
                        else
                        {
                            <span class="page-link">Next</span>
                        }
                    </li>
                </ul>
            </nav>
        }
    </div>
</div>

<script>
    document.addEventListener("DOMContentLoaded", function () {
        const createCommentCard = document.getElementById("createCommentCard");
        const editCommentCard = document.getElementById("editCommentCard");
        const cancelEditComment = document.getElementById("cancelEditComment");

        if (cancelEditComment) {
            cancelEditComment.addEventListener("click", function () {
                if (editCommentCard) {
                    editCommentCard.classList.add("d-none");
                }

                if (createCommentCard) {
                    createCommentCard.classList.remove("d-none");
                }
            });
        }

        document.querySelectorAll(".reply-toggle").forEach(function (button) {
            button.addEventListener("click", function () {
                const commentId = button.dataset.commentId;
                const replyForm = document.getElementById("reply-form-" + commentId);

                if (!replyForm) {
                    return;
                }

                const isHidden = replyForm.classList.toggle("d-none");
                button.setAttribute("aria-expanded", String(!isHidden));

                if (!isHidden) {
                    const textarea = replyForm.querySelector("textarea");
                    if (textarea) {
                        textarea.focus();
                    }
                }
            });
        });

        document.querySelectorAll(".reply-cancel").forEach(function (button) {
            button.addEventListener("click", function () {
                const commentId = button.dataset.commentId;
                const replyForm = document.getElementById("reply-form-" + commentId);
                const toggleButton = document.querySelector(
                    '.reply-toggle[data-comment-id="' + commentId + '"]'
                );

                if (replyForm) {
                    replyForm.classList.add("d-none");

                    const form = replyForm.querySelector("form");
                    if (form) {
                        form.reset();
                    }
                }

                if (toggleButton) {
                    toggleButton.setAttribute("aria-expanded", "false");
                }
            });
        });
    });
</script>
