@model ViewModels.Comment.CommentCreateView

<form asp-controller="Comment" asp-action="Create" method="post">
    @Html.AntiForgeryToken()

    <input asp-for="PostId" type="hidden" />
    <input asp-for="ParentCommentId" type="hidden" />
    <input type="hidden" name="page" value="@(ViewData["CurrentPage"] ?? 1)" />

    <div class="mb-2">
        <label asp-for="Content" class="form-label">Your reply</label>
        <textarea asp-for="Content" class="form-control" rows="3"></textarea>
        <span asp-validation-for="Content" class="text-danger"></span>
    </div>

    <button type="submit" class="btn btn-primary btn-sm">Reply</button>
</form>