@model ViewModels.Comment.CommentCreateView


<form asp-action="Create"
      method="post">


    <input asp-for="PostId"
           type="hidden" />



    <div class="mb-3">


        <label asp-for="Content"
               class="form-label">
        </label>



        <textarea asp-for="Content"
                  class="form-control"
                  rows="4">
        </textarea>



        <span asp-validation-for="Content"
              class="text-danger">
        </span>


    </div>



    <button class="btn btn-success"
            type="submit">

        Create Comment

    </button>


</form>