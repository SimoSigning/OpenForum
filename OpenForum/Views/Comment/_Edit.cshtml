@model ViewModels.Comment.CommentEditView

<form asp-action="Update" method="post">
    <input asp-for="Id" type="hidden" />
    <input asp-for="PostId" type="hidden" />
    <input type="hidden" name="page" value="@(ViewData["CurrentPage"] ?? 1)" />

    <div class="mb-2">
        <input asp-for="Title" class="form-control" placeholder="Enter a comment title..." />
        <span asp-validation-for="Title" class="text-danger small"></span>
    </div>

    <div class="mb-3">
        <textarea asp-for="Content" class="form-control" rows="3" placeholder="Write your comment..."></textarea>
        <span asp-validation-for="Content" class="text-danger small"></span>
    </div>

    <div class="d-flex flex-wrap gap-2">
        <button type="submit" class="btn btn-primary btn-sm">
            Save Changes
        </button>
        <button type="button" id="cancelEditComment" class="btn btn-outline-secondary btn-sm">
            Cancel
        </button>
    </div>
</form>