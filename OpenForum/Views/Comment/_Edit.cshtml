@model ViewModels.Comment.CommentEditView

<form asp-action="Update" method="post">

    <input asp-for="Id" type="hidden" />

    <input asp-for="PostId" type="hidden" />

    <input type="hidden"
           name="page"
           value="@(ViewData["CurrentPage"] ?? 1)" />

    <div class="mb-3">

        <label asp-for="Content" class="form-label">
        </label>

        <textarea asp-for="Content"
                  class="form-control"
                  rows="4"></textarea>

        <span asp-validation-for="Content"
              class="text-danger"></span>

    </div>

    <button type="submit" class="btn btn-primary">
        Save Changes
    </button>

</form>