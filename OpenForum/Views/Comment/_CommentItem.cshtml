
@model ViewModels.Comment.CommentListItemView

<div id="comment-@Model.Id" class="card shadow-sm mb-3">
    <div class="card-body p-3 p-md-4">

        @if (Model.ParentCommentId.HasValue)
        {
            <div class="text-muted small mb-2">
                Replying to <strong>@Model.ParentCreator</strong>:
                @Model.ParentTitle
            </div>
        }

        @if (!Model.ParentCommentId.HasValue)
        {
            <h5 class="card-title mb-2">@Model.Title</h5>
        }

        <div class="card-text text-break">
            @Model.Content
        </div>

        <div class="text-muted small mt-3">
            <span>By <strong class="text-body">@Model.Creator</strong></span>
            <span aria-hidden="true"> · </span>
            <time datetime="@Model.CreatedAt.ToUniversalTime().ToString("O")">
                @Model.CreatedAt.ToLocalTime().ToString("g")
            </time>
        </div>

        <div class="d-flex flex-wrap align-items-center gap-2 mt-3 pt-3 border-top">

            <div class="d-flex flex-wrap align-items-center gap-2 me-auto">

                @if (Model.CanLike)
                {
                    <form asp-controller="Like" asp-action="ToggleCommentLike" method="post" class="d-inline js-like-form">

                        @Html.AntiForgeryToken()

                        <input type="hidden" name="commentId" value="@Model.Id" />

                        <input type="hidden" name="returnUrl"
                               value="@Url.Action("Details", "Comment",
                                   new {
                                       id = (int)ViewData["PostId"]!,
                                       page = (int)(ViewData["CurrentPage"] ?? 1)
                                   })" />

                        <button type="submit" data-like-button
                                class="btn btn-sm @(Model.IsLikedByCurrentUser
                                    ? "btn-primary"
                                    : "btn-outline-primary")"
                                aria-pressed="@Model.IsLikedByCurrentUser">

                            <span data-like-label>
                                @(Model.IsLikedByCurrentUser ? "♥ Liked" : "♡ Like")
                            </span>

                            <span class="ms-1" data-like-count>
                                @Model.LikeCount
                            </span>
                        </button>
                    </form>
                }
                else
                {
                    <span class="text-muted small">
                        ♡ @Model.LikeCount
                        @(Model.LikeCount == 1 ? "like" : "likes")
                    </span>
                }

                @if (User.Identity?.IsAuthenticated ?? false)
                {
                    <a href="#" class="show-likers small text-decoration-none px-1" data-type="comment" data-id="@Model.Id">
                        Show likes
                    </a>
                }

                @if (ViewData["CanCreate"] is bool canCreate && canCreate)
                {
                    <button type="button"
                            class="btn btn-outline-secondary btn-sm"
                            data-bs-toggle="collapse"
                            data-bs-target="#reply-form-@Model.Id"
                            aria-expanded="false"
                            aria-controls="reply-form-@Model.Id">
                        Reply
                    </button>
                }
            </div>

            @if (Model.CanManage)
            {
                <div class="d-flex align-items-center gap-2 ms-auto">
                    <a asp-controller="Comment"
                       asp-action="Edit"
                       asp-route-id="@Model.Id"
                       asp-route-postId="@ViewData["PostId"]"
                       asp-route-page="@ViewData["CurrentPage"]"
                       class="btn btn-outline-secondary btn-sm">
                        Edit
                    </a>

                    <form asp-controller="Comment"
                          asp-action="Delete"
                          method="post"
                          class="d-inline"
                          onsubmit="return confirm('Are you sure you want to delete this comment?');">

                        @Html.AntiForgeryToken()

                        <input type="hidden" name="id" value="@Model.Id" />

                        <input type="hidden" name="postId" value="@ViewData["PostId"]" />

                        <input type="hidden" name="page" value="@ViewData["CurrentPage"]" />

                        <button type="submit" class="btn btn-outline-danger btn-sm">
                            Delete
                        </button>
                    </form>
                </div>
            }
        </div>

        @if (ViewData["CanCreate"] is bool canReply && canReply)
        {
            <div class="collapse mt-3" id="reply-form-@Model.Id">
                @{
                    var replyViewData = new ViewDataDictionary(ViewData)
                        {
                            ["CurrentPage"] = ViewData["CurrentPage"]
                        };
                }

                @await Html.PartialAsync(
                    "_Reply",
                    new ViewModels.Comment.CommentCreateView
                    {
                        PostId = (int)ViewData["PostId"]!,
                        ParentCommentId = Model.Id
                    },
                    replyViewData)
            </div>
        }
    </div>
</div>

@if (Model.Replies.Count > 0)
{
    <div class="ms-3 ms-md-4 ps-3 border-start">
        @foreach (var reply in Model.Replies)
        {
            @await Html.PartialAsync("_CommentItem", reply, ViewData)
        }
    </div>
}
