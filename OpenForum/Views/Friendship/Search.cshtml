 @model ViewModels.Friends.UserSearchView

@{
    ViewData["Title"] = "Search Users";
}

<div class="row justify-content-left">
    <div class="col-12 col-lg-10">

        <div class="mb-4">
            <h1 class="mb-1">Find Users</h1>
            <p class="text-muted mb-0">
                Search for other members and send friend requests.
            </p>
        </div>

        <!-- Search form -->
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-body-tertiary">
                <h2 class="h5 mb-0">Search by Username</h2>
            </div>

            <div class="card-body">
                <form asp-controller="Friendship" asp-action="Search" method="get">
                    <div class="input-group">
                        <input type="text"
                               name="query"
                               value="@Model.SearchQuery"
                               class="form-control"
                               placeholder="Enter a username..."
                               aria-label="Search username" />

                        <button type="submit" class="btn btn-primary">
                            Search
                        </button>
                    </div>
                </form>
            </div>
        </div>

        @if (!string.IsNullOrWhiteSpace(Model.SearchQuery))
        {
            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2 mb-3">
                <div>
                    <h2 class="h4 mb-1">Search Results</h2>
                    <p class="text-muted mb-0">
                        Results for "<strong>@Model.SearchQuery</strong>".
                    </p>
                </div>

                <span class="badge bg-secondary rounded-pill align-self-start align-self-sm-center">
                    @Model.Users.Count() @(Model.Users.Count() == 1 ? "user" : "users")
                </span>
            </div>

            @if (!Model.Users.Any())
            {
                <div class="card shadow-sm">
                    <div class="card-body text-center py-5">
                        <h3 class="h5 mb-2">No users found</h3>
                        <p class="text-muted mb-0">
                            Try searching with a different username.
                        </p>
                    </div>
                </div>
            }
            else
            {
                <div class="d-flex flex-column gap-3">
                    @foreach (var user in Model.Users)
                    {
                        <div class="card shadow-sm">
                            <div class="card-body">
                                <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3">
                                    <div>
                                        <h3 class="h5 mb-1">
                                            <a asp-controller="PublicProfile"
                                               asp-action="Index"
                                               asp-route-userId="@user.UserId"
                                               asp-route-userName="@user.Username"
                                               asp-route-returnUrl="@(Context.Request.Path + Context.Request.QueryString)"
                                               class="text-decoration-none text-body">
                                                @user.Username
                                            </a>
                                        </h3>

                                        @if (!string.IsNullOrWhiteSpace(user.RelationshipStatus))
                                        {
                                            @if (user.RelationshipStatus == "Friends")
                                            {
                                                <span class="badge bg-success">Friends</span>
                                            }
                                            else if (user.RelationshipStatus == "Request sent")
                                            {
                                                <span class="badge bg-secondary">Request sent</span>
                                            }
                                            else if (user.RelationshipStatus == "Request received")
                                            {
                                                <span class="badge bg-info text-dark">Request received</span>
                                            }
                                        }
                                    </div>

                                    @if (user.CanSendRequest)
                                    {
                                        <form asp-controller="Friendship" asp-action="SendRequest" method="post">
                                            <input type="hidden" name="addresseeUserId" value="@user.UserId" />
                                            <input type="hidden" name="query" value="@Model.SearchQuery" />

                                            <button type="submit" class="btn btn-primary btn-sm">
                                                Add Friend
                                            </button>
                                        </form>
                                    }
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }

            @if (Model.TotalPages > 1)
            {
                <nav aria-label="User search pagination" class="mt-4">
                    <ul class="pagination justify-content-left flex-wrap">
                        <li class="page-item @(Model.CurrentPage <= 1 ? "disabled" : "")">
                            @if (Model.CurrentPage > 1)
                            {
                                <a class="page-link"
                                   asp-action="Search"
                                   asp-route-query="@Model.SearchQuery"
                                   asp-route-page="@(Model.CurrentPage - 1)">
                                    Previous
                                </a>
                            }
                            else
                            {
                                <span class="page-link">Previous</span>
                            }
                        </li>

                        @for (int pageNumber = 1; pageNumber <= Model.TotalPages; pageNumber++)
                        {
                            <li class="page-item @(pageNumber == Model.CurrentPage ? "active" : "")">
                                <a class="page-link"
                                   asp-action="Search"
                                   asp-route-query="@Model.SearchQuery"
                                   asp-route-page="@pageNumber"
                                   aria-current="@(pageNumber == Model.CurrentPage ? "page" : null)">
                                    @pageNumber
                                </a>
                            </li>
                        }

                        <li class="page-item @(Model.CurrentPage >= Model.TotalPages ? "disabled" : "")">
                            @if (Model.CurrentPage < Model.TotalPages)
                            {
                                <a class="page-link"
                                   asp-action="Search"
                                   asp-route-query="@Model.SearchQuery"
                                   asp-route-page="@(Model.CurrentPage + 1)">
                                    Next
                                </a>
                            }
                            else
                            {
                                <span class="page-link">Next</span>
                            }
                        </li>
                    </ul>
                </nav>
            }
        }
    </div>
</div>