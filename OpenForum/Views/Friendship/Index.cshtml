 @model ViewModels.Friends.FriendsIndexView

@{
    ViewData["Title"] = "Friends";
}

<div class="row justify-content-left">
    <div class="col-12 col-lg-10">

        <div class="mb-4">
            <h1 class="mb-1">Friends</h1>
            <p class="text-muted mb-0">
                Manage your friends and incoming friend requests.
            </p>
        </div>

        <!-- Incoming friend requests -->
        <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2 mb-3">
            <div>
                <h2 class="h4 mb-1">Incoming Requests</h2>
                <p class="text-muted mb-0">
                    People who would like to connect with you.
                </p>
            </div>

            <span class="badge bg-secondary rounded-pill align-self-start align-self-sm-center">
                @Model.IncomingRequests.Count() @(Model.IncomingRequests.Count() == 1 ? "request" : "requests")
            </span>
        </div>

        @if (!Model.IncomingRequests.Any())
        {
            <div class="card shadow-sm mb-4">
                <div class="card-body text-center py-4">
                    <h3 class="h5 mb-2">No incoming requests</h3>
                    <p class="text-muted mb-0">
                        You don't have any pending friend requests.
                    </p>
                </div>
            </div>
        }
        else
        {
            <div class="d-flex flex-column gap-3 mb-4">
                @foreach (var request in Model.IncomingRequests)
                {
                    <div class="card shadow-sm">
                        <div class="card-body">
                            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3">
                                <div>
                                    <h3 class="h5 mb-1">@request.Username</h3>
                                    <span class="text-muted small">
                                        Sent @request.CreatedAt
                                    </span>
                                </div>

                                <div class="d-flex flex-wrap gap-2">
                                    <form asp-controller="Friendship" asp-action="AcceptRequest" method="post">
                                        <input type="hidden" name="friendshipId" value="@request.FriendshipId" />
                                        <button type="submit" class="btn btn-primary btn-sm">
                                            Accept
                                        </button>
                                    </form>

                                    <form asp-controller="Friendship" asp-action="DeclineRequest" method="post"
                                          onsubmit="return confirm('Are you sure you want to decline this friend request?');">
                                        <input type="hidden" name="friendshipId" value="@request.FriendshipId" />
                                        <button type="submit" class="btn btn-outline-danger btn-sm">
                                            Decline
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }

        <hr class="my-4" />

        <!-- Friends list -->
        <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2 mb-3">
            <div>
                <h2 class="h4 mb-1">Your Friends</h2>
                <p class="text-muted mb-0">
                    People you have connected with.
                </p>
            </div>

            <span class="badge bg-secondary rounded-pill align-self-start align-self-sm-center">
                @Model.Friends.Count() @(Model.Friends.Count() == 1 ? "friend" : "friends")
            </span>
        </div>

        @if (!Model.Friends.Any())
        {
            <div class="card shadow-sm">
                <div class="card-body text-center py-5">
                    <h3 class="h5 mb-2">You haven't added any friends yet</h3>
                    <p class="text-muted mb-3">
                        Search for other users to find people to connect with.
                    </p>
                    <a asp-controller="Friendship" asp-action="Search" class="btn btn-primary btn-sm">
                        Find Users
                    </a>
                </div>
            </div>
        }
        else
        {
            <div class="d-flex flex-column gap-3">
                @foreach (var friend in Model.Friends)
                {
                    <div class="card shadow-sm">
                        <div class="card-body">
                            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3">
                                <div>
                                    <h3 class="h5 mb-1">@friend.Username</h3>
                                    <span class="badge bg-success">Friends</span>
                                </div>

                                <form asp-controller="Friendship" asp-action="RemoveFriend" method="post"
                                      onsubmit="return confirm('Are you sure you want to remove this friend?');">
                                    <input type="hidden" name="friendshipId" value="@friend.FriendshipId" />
                                    <button type="submit" class="btn btn-outline-danger btn-sm">
                                        Remove Friend
                                    </button>
                                </form>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }

    </div>
</div>