 @model ViewModels.Friends.FriendsIndexView

@{
    ViewData["Title"] = "Friends";
}

<div class="row justify-content-left">
    <div class="col-12 col-lg-10">

        @{
            int incomingCount = Model.IncomingRequests.Count();
            int outgoingCount = Model.OutgoingRequests.Count();
        }

        <!-- Friend request tabs -->
        <div class="mb-4">

            <div class="mb-3">
                <h2 class="h4 mb-1">Friend Requests</h2>
                <p class="text-muted mb-0">
                    Manage requests you have received and sent.
                </p>
            </div>

            <!-- Toggle buttons -->
            <ul class="nav nav-pills gap-2 mb-3" id="friendRequestTabs" role="tablist">

                <li class="nav-item" role="presentation">
                    <button class="nav-link active"
                            id="incoming-tab"
                            data-bs-toggle="pill"
                            data-bs-target="#incoming-requests"
                            type="button"
                            role="tab"
                            aria-controls="incoming-requests"
                            aria-selected="true">

                        Incoming
                        <span class="badge bg-secondary rounded-pill ms-1">
                            @incomingCount
                        </span>

                    </button>
                </li>

                <li class="nav-item" role="presentation">
                    <button class="nav-link"
                            id="outgoing-tab"
                            data-bs-toggle="pill"
                            data-bs-target="#outgoing-requests"
                            type="button"
                            role="tab"
                            aria-controls="outgoing-requests"
                            aria-selected="false">

                        Sent
                        <span class="badge bg-secondary rounded-pill ms-1">
                            @outgoingCount
                        </span>

                    </button>
                </li>

            </ul>

            <!-- Tab content -->
            <div class="tab-content">

                <!-- Incoming requests -->
                <div class="tab-pane fade show active"
                     id="incoming-requests"
                     role="tabpanel"
                     aria-labelledby="incoming-tab"
                     tabindex="0">

                    @if (!Model.IncomingRequests.Any())
                    {
                        <div class="card shadow-sm">
                            <div class="card-body text-center py-4">
                                <h3 class="h5 mb-2">No incoming requests</h3>
                                <p class="text-muted mb-0">
                                    You don't have any pending friend requests.
                                </p>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="d-flex flex-column gap-3">

                            @foreach (var request in Model.IncomingRequests)
                            {
                                <div class="card shadow-sm">
                                    <div class="card-body">

                                        <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3">

                                            <div>
                                                <h3 class="h5 mb-1">
                                                    <a asp-controller="PublicProfile"
                                                       asp-action="Index"
                                                       asp-route-userName="@request.Username"
                                                       asp-route-returnUrl="@(Context.Request.Path + Context.Request.QueryString)"
                                                       class="text-decoration-none text-body">
                                                        @request.Username
                                                    </a>
                                                </h3>

                                                <span class="text-muted small">
                                                    Sent @request.CreatedAt
                                                </span>
                                            </div>

                                            <div class="d-flex flex-wrap gap-2">

                                                <form asp-controller="Friendship"
                                                      asp-action="AcceptRequest"
                                                      method="post">

                                                    <input type="hidden"
                                                           name="friendshipId"
                                                           value="@request.FriendshipId" />

                                                    <button type="submit"
                                                            class="btn btn-primary btn-sm">
                                                        Accept
                                                    </button>
                                                </form>

                                                <form asp-controller="Friendship"
                                                      asp-action="DeclineRequest"
                                                      method="post"
                                                      onsubmit="return confirm('Are you sure you want to decline this friend request?');">

                                                    <input type="hidden"
                                                           name="friendshipId"
                                                           value="@request.FriendshipId" />

                                                    <button type="submit"
                                                            class="btn btn-outline-danger btn-sm">
                                                        Decline
                                                    </button>
                                                </form>

                                            </div>
                                        </div>
                                    </div>
                                </div>
                            }

                        </div>
                    }

                </div>

                <!-- Outgoing requests -->
                <div class="tab-pane fade"
                     id="outgoing-requests"
                     role="tabpanel"
                     aria-labelledby="outgoing-tab"
                     tabindex="0">

                    @if (!Model.OutgoingRequests.Any())
                    {
                        <div class="card shadow-sm">
                            <div class="card-body text-center py-4">
                                <h3 class="h5 mb-2">No sent requests</h3>
                                <p class="text-muted mb-0">
                                    You haven't sent any pending friend requests.
                                </p>
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="d-flex flex-column gap-3">

                            @foreach (var request in Model.OutgoingRequests)
                            {
                                <div class="card shadow-sm">
                                    <div class="card-body">

                                        <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3">

                                            <div>
                                                <h3 class="h5 mb-1">
                                                    <a asp-controller="PublicProfile"
                                                       asp-action="Index"
                                                       asp-route-userName="@request.Username"
                                                       asp-route-returnUrl="@(Context.Request.Path + Context.Request.QueryString)"
                                                       class="text-decoration-none text-body">
                                                        @request.Username
                                                    </a>
                                                </h3>

                                                <span class="badge bg-secondary">
                                                    Awaiting response
                                                </span>

                                                <div class="text-muted small mt-1">
                                                    Sent @request.CreatedAt
                                                </div>
                                            </div>

                                            <div>
                                                <form asp-controller="Friendship"
                                                      asp-action="CancelRequest"
                                                      method="post"
                                                      onsubmit="return confirm('Are you sure you want to cancel this friend request?');">

                                                    <input type="hidden"
                                                           name="friendshipId"
                                                           value="@request.FriendshipId" />

                                                    <button type="submit"
                                                            class="btn btn-outline-danger btn-sm">
                                                        Cancel Request
                                                    </button>

                                                </form>
                                            </div>

                                        </div>
                                    </div>
                                </div>
                            }

                        </div>
                    }

                </div>

            </div>
        </div>


        <hr class="my-4" />

        <!-- Friends list -->
        <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-2 mb-3">
            <div>
                <h2 class="h4 mb-1">Your Friends</h2>
                <p class="text-muted mb-0">
                    People you have connected with.
                </p>
            </div>

            <span class="badge bg-secondary rounded-pill align-self-start align-self-sm-center">
                @Model.Friends.Count() @(Model.Friends.Count() == 1 ? "friend" : "friends")
            </span>
        </div>

        @if (!Model.Friends.Any())
        {
            <div class="card shadow-sm">
                <div class="card-body text-center py-5">
                    <h3 class="h5 mb-2">You haven't added any friends yet</h3>
                    <p class="text-muted mb-3">
                        Search for other users to find people to connect with.
                    </p>
                    <a asp-controller="Friendship" asp-action="Search" class="btn btn-primary btn-sm">
                        Find Users
                    </a>
                </div>
            </div>
        }
        else
        {
            <div class="d-flex flex-column gap-3">
                @foreach (var friend in Model.Friends)
                {
                    <div class="card shadow-sm">
                        <div class="card-body">
                            <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3">
                                <div>
                                    <h3 class="h5 mb-1">
                                        <a asp-controller="PublicProfile"
                                           asp-action="Index"
                                           asp-route-userName="@friend.Username"
                                           asp-route-returnUrl="@(Context.Request.Path + Context.Request.QueryString)"
                                           class="text-decoration-none text-body">
                                            @friend.Username
                                        </a>
                                    </h3>
                                    <span class="badge bg-success">Friends</span>
                                </div>
                                <div class="d-flex flex-wrap align-items-center gap-2">

                                    @if ((User.Identity?.IsAuthenticated ?? false) && !string.Equals(User.Identity?.Name, friend.Username, StringComparison.OrdinalIgnoreCase))
                                    {
                                        <a asp-controller="Message"
                                           asp-action="Compose"
                                           asp-route-recipientUserName="@friend.Username"
                                           asp-route-returnUrl="@(Context.Request.Path + Context.Request.QueryString)"
                                           class="btn btn-primary btn-sm">
                                            <i class="bi bi-envelope me-1"></i>
                                            Send Message
                                        </a>
                                    }

                                    <form asp-controller="Friendship"
                                          asp-action="RemoveFriend"
                                          method="post"
                                          onsubmit="return confirm('Are you sure you want to remove this friend?');">

                                        <input type="hidden"
                                               name="friendshipId"
                                               value="@friend.FriendshipId" />

                                        <button type="submit" class="btn btn-outline-danger btn-sm">
                                            Remove Friend
                                        </button>
                                    </form>

                                </div>
                            </div>
                        </div>
                    </div>
                }
            </div>
        }

    </div>
</div>