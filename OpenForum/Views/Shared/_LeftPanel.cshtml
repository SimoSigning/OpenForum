@if (User.Identity?.IsAuthenticated ?? false)
{
    <div class="left-panel-menu">

        <a asp-controller="Message"
           asp-action="Inbox"
           class="left-panel-link">
            Messages
            @await Component.InvokeAsync("UnreadMessages")
        </a>

        <a asp-controller="Friendship"
           asp-action="Index"
           class="left-panel-link">
            Friends
        </a>

        <a asp-controller="Friendship"
           asp-action="Search"
           class="left-panel-link">
            Search users
        </a>

        <a asp-controller="MyActivity"
           asp-action="Index"
           class="left-panel-link">
            My activity
        </a>

    </div>
}

<div class="left-panel-menu">
    <a asp-controller="Misc"
       asp-action="About"
       class="left-panel-link">
        About
    </a>
</div>