<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - OpenForum</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">

    <link rel="stylesheet" href="~/css/forum.css" asp-append-version="true" />
</head>

<body class="bg-light">

    <!-- Header -->
    <header class="bg-dark text-white py-3">
        <div class="container-fluid px-4">

            <div class="d-flex flex-column flex-sm-row
                        justify-content-between align-items-sm-center gap-3">

                <h1 class="h2 mb-0 text-nowrap">
                    <a asp-controller="Topic"
                       asp-action="Index"
                       class="text-white text-decoration-none">
                        OpenForum
                    </a>
                </h1>

                <div class="d-flex flex-wrap align-items-center gap-2">

                    @if (User.Identity?.IsAuthenticated ?? false)
                    {
                        <span class="text-white-50 small me-1">
                            Welcome @User.Identity.Name
                        </span>

                        <a asp-controller="MyProfile"
                           asp-action="Index"
                           class="btn btn-outline-light btn-sm">
                            Edit profile
                        </a>

                        <form asp-area="Identity"
                              asp-page="/Account/Logout"
                              method="post"
                              class="d-inline">

                            <button type="submit"
                                    class="btn btn-outline-light btn-sm">
                                Logout
                            </button>
                        </form>
                    }
                    else
                    {
                        <a asp-area="Identity"
                           asp-page="/Account/Login"
                           class="btn btn-outline-light btn-sm">
                            Login
                        </a>

                        <a asp-area="Identity"
                           asp-page="/Account/Register"
                           class="btn btn-light btn-sm">
                            Register
                        </a>
                    }

                </div>
            </div>
        </div>
    </header>


    <div class="page-layout">

        <aside class="left-panel">
            @await Html.PartialAsync("_LeftPanel")
        </aside>

        <main class="main-content">
            @RenderBody()
        </main>

        <aside class="right-panel">
            @await Html.PartialAsync("_RightPanel")
        </aside>

    </div>


    <!-- Footer -->
    <footer class="site-footer bg-dark text-white-50">
        <div class="container-fluid px-4 text-center">
            <small>
                &copy; @DateTime.Now.Year OpenForum. All rights reserved.
            </small>
        </div>
    </footer>


    <!-- Scripts -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js">
    </script>

    <script src="~/js/likes.js" asp-append-version="true"></script>

    @await RenderSectionAsync("Scripts", required: false)


    <!-- Likes modal -->
    <div class="modal fade" id="likersModal" tabindex="-1"
         aria-labelledby="likersModalLabel" aria-hidden="true">

        <div class="modal-dialog modal-dialog-centered">

            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title" id="likersModalLabel">
                        People who liked this
                    </h5>

                    <button type="button" class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Close">
                    </button>
                </div>

                <div class="modal-body">

                    <p id="likersLoading" class="d-none">
                        Loading likes...
                    </p>

                    <p id="likersError" class="text-danger d-none">
                        Could not load likes. Please try again.
                    </p>

                    <p id="likersEmpty" class="d-none">
                        No likes yet.
                    </p>

                    <ul id="likersList"
                        class="list-group list-group-flush">
                    </ul>

                </div>
            </div>
        </div>
    </div>

</body>
</html>