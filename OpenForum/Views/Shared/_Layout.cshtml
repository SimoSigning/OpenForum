<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>@ViewData["Title"] - OpenForum</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet">
    <link rel="stylesheet" href="~/css/forum.css" asp-append-version="true" />
</head>

<body class="bg-light">

    <header class="bg-dark text-white py-3 mb-4">
        <div class="container">
            <div class="row">
                <div class="col-12 col-lg-9 mx-auto">
                    <div class="d-flex flex-column flex-sm-row justify-content-between align-items-sm-center gap-3">

                        <h1 class="h2 mb-0 text-nowrap">
                            <a asp-controller="Topic" asp-action="Index" class="text-white text-decoration-none">
                                OpenForum
                            </a>
                        </h1>

                        <div class="d-flex flex-wrap align-items-center gap-2">
                            @if (User.Identity?.IsAuthenticated ?? false)
                            {
                                <span class="text-white-50 small me-1">
                                    Welcome @User.Identity.Name
                                </span>

                                <a asp-controller="User"
                                   asp-action="Index"
                                   class="btn btn-outline-light btn-sm">
                                    Edit profile
                                </a>

                                <form asp-area="Identity"
                                      asp-page="/Account/Logout"
                                      method="post"
                                      class="d-inline">
                                    <button type="submit" class="btn btn-outline-light btn-sm">
                                        Logout
                                    </button>
                                </form>
                            }
                            else
                            {
                                <a asp-area="Identity" asp-page="/Account/Login" class="btn btn-outline-light btn-sm">
                                    Login
                                </a>

                                <a asp-area="Identity" asp-page="/Account/Register" class="btn btn-light btn-sm">
                                    Register
                                </a>
                            }
                        </div>

                    </div>
                </div>
            </div>
        </div>
    </header>

    <main class="container">
        <div class="row">

            <!-- Sidebar -->
            <aside class="col-12 col-md-3 col-lg-3 mb-4">
                <div class="card shadow-sm">
                    <div class="card-header bg-white">
                        <h5 class="mb-0">Menu</h5>
                    </div>

                    <div class="list-group list-group-flush">

                        <a href="#"
                           class="list-group-item list-group-item-action">
                            <i class="bi bi-people me-2"></i>
                            Search users
                        </a>

                        <a href="#"
                           class="list-group-item list-group-item-action">
                            <i class="bi bi-search me-2"></i>
                            Search posts
                        </a>

                        <a href="#"
                           class="list-group-item list-group-item-action">
                            <i class="bi bi-info-circle me-2"></i>
                            About
                        </a>

                    </div>
                </div>
            </aside>

            <!-- Main content -->
            <section class="col-12 col-md-9 col-lg-9">
                @RenderBody()
            </section>

        </div>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/likes.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)

    <div class="modal fade" id="likersModal" tabindex="-1"
     aria-labelledby="likersModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="likersModalLabel">
                    People who liked this
                </h5>
                <button type="button" class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p id="likersLoading" class="d-none">Loading likes...</p>
                <p id="likersError" class="text-danger d-none">
                    Could not load likes. Please try again.
                </p>
                <p id="likersEmpty" class="d-none">
                    No likes yet.
                </p>
                <ul id="likersList" class="list-group list-group-flush"></ul>
            </div>
        </div>
    </div>
</div>

</body>
</html>