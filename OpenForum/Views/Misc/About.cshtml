@{
    ViewData["Title"] = "About OpenForum";
}

<div class="row justify-content-left">
    <div class="col-12 col-lg-10">
        <h1 class="mb-2">About OpenForum</h1>
        <p class="text-muted mb-4">
            A place for conversations, without the unnecessary noise.
        </p>

        <div class="card shadow-sm mb-4">
            <div class="card-body">
                <h4 class="mb-3">Just a forum</h4>

                <p>
                    OpenForum is built around a simple idea: a forum should be a
                    place where people can share ideas, ask questions, and have
                    discussions. It doesn't need to be more complicated than that.
                </p>

                <p class="mb-0">
                    We believe in keeping things simple, focusing on the community
                    rather than distractions, engagement tricks, or features nobody
                    asked for.
                </p>
            </div>
        </div>

        <div class="card shadow-sm">
            <div class="card-body">
                <h4 class="mb-3">A straightforward approach</h4>

                <p>
                    OpenForum is intended to remain a straightforward community
                    platform. Your participation should be about the conversations
                    you choose to have, not about being turned into a product.
                </p>

                <p class="mb-0">
                    We don't sell user data or build advertising around users.
                    Should that philosophy ever change, it won't happen quietly:
                    any such functionality would require your explicit agreement.
                </p>
            </div>
        </div>
    </div>
</div>