
@model ViewModels.Messages.InboxView

@{
    ViewData["Title"] = "Inbox";
}

<div class="container py-4">
    <div class="d-flex flex-column flex-sm-row
        justify-content-between align-items-sm-center mb-4 gap-3">

        <div>
            <h2>Inbox</h2>

            <p class="text-muted mb-0">
                You have @Model.UnreadCount unread message(s).
            </p>
        </div>

        <div class="d-flex gap-2">

            <a asp-controller="Message"
               asp-action="Compose"
               class="btn btn-primary">

                <i class="bi bi-pencil-square me-1"></i>
                New message

            </a>

            <a asp-controller="Message"
               asp-action="Sent"
               class="btn btn-outline-primary">

                Sent messages

            </a>

        </div>

    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (!Model.Messages.Any())
    {
        <div class="alert alert-light border">
            Your inbox is empty.
        </div>
    }
    else
    {
        <div class="list-group">

            @foreach (var message in Model.Messages)
            {
                <div class="list-group-item
                     @(message.IsDeletedBySender
                         ? "bg-light"
                         : message.IsRead
                             ? ""
                             : "list-group-item-light fw-bold")">

                    <div class="d-flex justify-content-between
                                align-items-start gap-3">

                        <a asp-controller="Message"
                           asp-action="Details"
                           asp-route-id="@message.Id"
                           class="text-decoration-none text-reset flex-grow-1">

                            <div class="d-flex justify-content-between">
                                <strong>
                                    @message.OtherUserName
                                </strong>

                                <small class="text-muted">
                                    @message.SentAt.ToString("g")
                                </small>
                            </div>

                            @if (message.IsDeletedBySender)
                            {
                                <div class="mt-2">
                                    <span class="text-muted">
                                        <i class="bi bi-info-circle me-1"></i>
                                        This message has been deleted by the sender.
                                    </span>
                                </div>
                            }
                            else
                            {
                                <div class="mt-1">
                                    @message.Subject

                                    @if (!message.IsRead)
                                    {
                                        <span class="badge bg-primary ms-2">
                                            Unread
                                        </span>
                                    }
                                </div>

                                <small class="text-muted">
                                    @message.BodyPreview
                                </small>
                            }

                        </a>

                        <form asp-controller="Message"
                              asp-action="DeleteInbox"
                              asp-route-id="@message.Id"
                              method="post"
                              class="flex-shrink-0">

                            <button type="submit"
                                    class="btn btn-sm btn-outline-danger"
                                    title="Remove from inbox"
                                    onclick="return confirm('Remove this message from your inbox?');">
                                    Delete
                                <i class="bi bi-trash"></i>
                            </button>

                        </form>

                    </div>
                </div>
            }

        </div>
    }
</div>
