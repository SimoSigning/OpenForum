@model ViewModels.Messages.ComposeMessageView

@{
    ViewData["Title"] = Model.IsReply ? "Reply to message" : "Compose message";
}

<div class="container py-4">
    <div class="card">
        <div class="card-header">
            <h2 class="mb-0">
                @(Model.IsReply ? "Reply to message" : "Compose message")
            </h2>
        </div>

        <div class="card-body">
            <form asp-controller="Message"
                  asp-action="Send"
                  method="post">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <input asp-for="RecipientUserName" type="hidden" />
                <input asp-for="IsReply" type="hidden" />
                <input asp-for="OriginalMessageId" type="hidden" />
                <input asp-for="ReturnUrl" type="hidden" />

                <div class="mb-3">
                    <label class="form-label">To</label>

                    <input type="text"
                           class="form-control"
                           value="@Model.RecipientUserName"
                           readonly />
                </div>

                <div class="mb-3">
                    <label asp-for="Subject" class="form-label"></label>

                    @if (Model.IsReply)
                    {
                        <input asp-for="Subject"
                               class="form-control"
                               readonly />
                    }
                    else
                    {
                        <input asp-for="Subject"
                               class="form-control" />
                    }

                    <span asp-validation-for="Subject"
                          class="text-danger">
                    </span>
                </div>

                <div class="mb-3">
                    <label asp-for="Body" class="form-label"></label>

                    <textarea asp-for="Body"
                              class="form-control"
                              rows="8"
                              placeholder="Write your message here...">
                    </textarea>

                    <span asp-validation-for="Body"
                          class="text-danger">
                    </span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary">
                        Send message
                    </button>

                    <a href="@Model.ReturnUrl"
                       class="btn btn-outline-secondary">
                        Cancel
                    </a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}