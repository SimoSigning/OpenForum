
@model ViewModels.Messages.SentMessagesView

@{
    ViewData["Title"] = "Sent messages";
}

<div class="container py-4">

    <div class="d-flex justify-content-between
                align-items-center mb-4">

        <h2>Sent messages</h2>

        <a asp-controller="Message"
           asp-action="Inbox"
           class="btn btn-outline-primary">

            Back to inbox

        </a>

    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (!Model.Messages.Any())
    {
        <div class="alert alert-light border">
            You haven't sent any messages yet.
        </div>
    }
    else
    {
        <div class="list-group">

            @foreach (var message in Model.Messages)
            {
                <div class="list-group-item">

                    <div class="d-flex justify-content-between
                                align-items-start gap-3">

                        <a asp-controller="Message"
                           asp-action="Details"
                           asp-route-id="@message.Id"
                           class="text-decoration-none text-reset flex-grow-1">

                            <div class="d-flex justify-content-between">

                                <strong>
                                    To: @message.OtherUserName
                                </strong>

                                <small class="text-muted">
                                    @message.SentAt.ToString("g")
                                </small>

                            </div>

                            <div class="mt-1">

                                @message.Subject

                                @if (message.IsRead)
                                {
                                    <span class="badge bg-success ms-2">
                                        Read
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary ms-2">
                                        Unread
                                    </span>
                                }

                            </div>

                            <small class="text-muted">
                                @message.BodyPreview
                            </small>

                        </a>

                        <form asp-controller="Message"
                              asp-action="DeleteSent"
                              asp-route-id="@message.Id"
                              method="post"
                              class="flex-shrink-0">

                            <button type="submit"
                                    class="btn btn-sm btn-outline-danger"
                                    title="Delete sent message"
                                    onclick="return confirm('Delete this sent message? The recipient will see a deleted-message notification.');">
                                    Delete
                                <i class="bi bi-trash"></i>

                            </button>

                        </form>

                    </div>

                </div>
            }

        </div>
    }

</div>
