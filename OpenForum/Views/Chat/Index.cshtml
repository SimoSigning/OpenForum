<!-- /Views/Chat/Index.cshtml-->
@{
    ViewData["Title"] = "Chat";
}

<div class="container-fluid py-4">
    @Html.AntiForgeryToken()
    <div class="mb-4">
        <h1>Chat</h1>
        <p class="text-muted">
            Chat with your friends or join one of the community chatrooms.
        </p>
    </div>

    <div id="chatError" class="alert alert-danger d-none"></div>

    <!-- Private chats -->
    <section class="card shadow-sm mb-4">

        <div class="card-header d-flex justify-content-between align-items-center">
            <h2 class="h5 mb-0">Your private chats</h2>

            <button type="button"
                    class="btn btn-primary btn-sm"
                    id="createChatButton">
                Create chat
            </button>
        </div>

        <div class="card-body">

            <div id="privateRoomsLoading" class="text-muted">
                Loading your chats...
            </div>

            <div id="privateRoomsEmpty" class="text-muted d-none">
                You haven't joined any private chats yet.
            </div>

            <div id="privateRoomsList"
                 class="list-group list-group-flush">
            </div>

        </div>
    </section>

    <!-- Create private chat modal -->
    <div class="modal fade"
         id="createChatModal"
         tabindex="-1"
         aria-labelledby="createChatModalLabel"
         aria-hidden="true">

        <div class="modal-dialog">
            <div class="modal-content">

                <div class="modal-header">
                    <h5 class="modal-title" id="createChatModalLabel">
                        Create private chat
                    </h5>

                    <button type="button"
                            class="btn-close"
                            data-bs-dismiss="modal"
                            aria-label="Close">
                    </button>
                </div>

                <div class="modal-body">

                    <div class="mb-3">
                        <label for="chatRoomName"
                               class="form-label">
                            Chatroom name
                        </label>

                        <input type="text"
                               id="chatRoomName"
                               class="form-control"
                               maxlength="100"
                               placeholder="Enter a chatroom name"
                               required />
                    </div>

                    <div class="mb-3">
                        <label class="form-label">
                            Invite friends
                        </label>

                        <div id="chatFriendsLoading"
                             class="text-muted">
                            Loading friends...
                        </div>

                        <div id="chatFriendsEmpty"
                             class="text-muted d-none">
                            You don't have any accepted friends yet.
                        </div>

                        <div id="chatFriendsList"
                             class="list-group">
                        </div>
                    </div>

                    <div id="createChatError"
                         class="alert alert-danger d-none">
                    </div>

                </div>

                <div class="modal-footer">

                    <button type="button"
                            class="btn btn-secondary"
                            data-bs-dismiss="modal">
                        Cancel
                    </button>

                    <button type="button"
                            class="btn btn-primary"
                            id="confirmCreateChatButton">
                        Create chat
                    </button>

                </div>

            </div>
        </div>
    </div>

    <!-- Miscellaneous chats -->
    <section class="card shadow-sm">

        <div class="card-header">
            <h2 class="h5 mb-0">Community chatrooms</h2>
        </div>

        <div class="card-body">

            <div id="miscRoomsLoading" class="text-muted">
                Loading community chatrooms...
            </div>

            <div id="miscRoomsEmpty" class="text-muted d-none">
                No community chatrooms are available.
            </div>

            <div id="miscRoomsList"
                 class="list-group list-group-flush">
            </div>

        </div>
    </section>

</div>

@section Scripts {
    <script src="~/js/chat-index.js" asp-append-version="true"></script>
}
